   "source": [
    "def permutation(l, newlst=[]):\n",
    "    if not l:\n",
    "        print(newlst)\n",
    "        return\n",
    "    for i in range(len(l)):\n",
    "        permutation(l[:i] + l[i+1:], newlst + l[i])\n",
    "\n",
    "permutation(lst)"
   ]
